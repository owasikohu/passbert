{
  "manifest_version": 3,
  "name": "PassBERT フォーム評価",
  "version": "0.1.0",
  "description": "日英フォームのローカル分類・正解ラベル付け・評価JSONL保存。入力値は収集しません。",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "action": {"default_title": "このページのフォームを評価"},
  "background": {"scripts": ["background.js"]},
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'"},
  "browser_specific_settings": {"gecko": {"id": "passbert-eval@owasikohu", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}
}
